{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "bun-types"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false
  },
  "include": [
    "ceremony/**/*.ts",
    "core/**/*.ts",
    "surface/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "*.d.ts"
  ]
}
