{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|search_replace|write|create_file|edit_file|str_replace",
        "hooks": [
          { "type": "command", "command": "bun run ${CLAUDE_PROJECT_DIR:-$PWD}/bin/witness.mjs guard || exit 2", "timeout": 10 }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "bun run ${CLAUDE_PROJECT_DIR:-$PWD}/bin/witness.mjs witness", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bun run ${CLAUDE_PROJECT_DIR:-$PWD}/bin/witness.mjs session", "timeout": 10 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "bun run ${CLAUDE_PROJECT_DIR:-$PWD}/bin/witness.mjs session", "timeout": 10 } ] }
    ]
  }
}
