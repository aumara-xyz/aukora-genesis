{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.aukora.xyz/swarm/WorkerResultV1.json",
  "title": "WorkerResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "resultId", "briefId", "campaignId", "issueNumber", "baseCommit", "baseTreeDigest", "briefDigest", "adapterDigest", "modelDigest", "patchHash", "claimKind", "summary", "identityBound", "state", "createdAt"],
  "properties": {
    "schema": { "const": "aukora-swarm-worker-result-v1" },
    "resultId": { "type": "string", "minLength": 1 },
    "briefId": { "type": "string", "minLength": 1 },
    "campaignId": { "type": "string", "minLength": 1 },
    "issueNumber": { "type": "integer" },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "baseTreeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "briefDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "adapterDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "modelDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "patchHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "claimKind": { "enum": ["built", "spec", "research", "blocked", "docs"] },
    "summary": { "type": "string" },
    "identityBound": { "const": false },
    "state": { "enum": ["proposed", "refused", "landed", "abandoned"] },
    "createdAt": { "type": "string", "minLength": 1 }
  }
}
