{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.aukora.xyz/swarm/WorkerRuntimeIdentityV1.json",
  "title": "WorkerRuntimeIdentityV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "workerId", "briefId", "campaignId", "adapterDigest", "modelDigest", "attestationDigest", "issuedAt", "expiresAt", "productionStanding"],
  "properties": {
    "schema": { "const": "aukora-swarm-worker-runtime-identity-v1" },
    "workerId": { "type": "string", "minLength": 1 },
    "briefId": { "type": "string", "minLength": 1 },
    "campaignId": { "type": "string", "minLength": 1 },
    "adapterDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "modelDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "attestationDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "issuedAt": { "type": "string", "minLength": 1 },
    "expiresAt": { "type": "string", "minLength": 1 },
    "productionStanding": { "const": false }
  }
}
