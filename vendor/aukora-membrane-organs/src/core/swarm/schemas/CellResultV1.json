{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.aukora.xyz/swarm/CellResultV1.json",
  "title": "CellResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cellId",
    "briefId",
    "briefDigest",
    "leaseDigest",
    "baseCommit",
    "baseTreeDigest",
    "parentReceiptAnchor",
    "childChainHead",
    "proposalDigest",
    "changedPaths",
    "unresolvedEffects",
    "attestationMode",
    "identityBound",
    "state",
    "createdAt"
  ],
  "properties": {
    "schema": { "const": "aukora-swarm-cell-result-v1" },
    "cellId": { "type": "string", "minLength": 1 },
    "briefId": { "type": "string", "minLength": 1 },
    "briefDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "leaseDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "baseTreeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "parentReceiptAnchor": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "childChainHead": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "proposalDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "changedPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "unresolvedEffects": { "type": "integer", "minimum": 0 },
    "attestationMode": { "const": "unbound-test" },
    "identityBound": { "const": false },
    "state": { "enum": ["proposed", "accepted", "rejected", "superseded", "interrupted", "in_doubt"] },
    "createdAt": { "type": "string", "minLength": 1 }
  }
}
