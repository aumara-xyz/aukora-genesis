{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.aukora.xyz/swarm/PathLeaseV1.json",
  "title": "PathLeaseV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "leaseId", "campaignId", "holderBriefId", "globs", "baseCommit", "baseTreeDigest", "issuedAt", "expiresAt", "state"],
  "properties": {
    "schema": { "const": "aukora-swarm-path-lease-v1" },
    "leaseId": { "type": "string", "minLength": 1 },
    "campaignId": { "type": "string", "minLength": 1 },
    "holderBriefId": { "type": "string", "minLength": 1 },
    "globs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "baseTreeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "issuedAt": { "type": "string", "minLength": 1 },
    "expiresAt": { "type": "string", "minLength": 1 },
    "state": { "enum": ["active", "expired", "released"] }
  }
}
