{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.aukora.xyz/swarm/DecompositionProposalV1.json",
  "title": "DecompositionProposalV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decompositionId", "parentBriefId", "campaignId", "parentChainAnchor", "depth", "children", "leaseInheritance", "budgetConservationDeclared", "state", "createdAt"],
  "properties": {
    "schema": { "const": "aukora-swarm-decomposition-proposal-v1" },
    "decompositionId": { "type": "string", "minLength": 1 },
    "parentBriefId": { "type": "string", "minLength": 1 },
    "campaignId": { "type": "string", "minLength": 1 },
    "parentChainAnchor": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "depth": { "type": "integer" },
    "children": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["childBriefId", "childBriefDigest", "idempotencyKey", "allowPaths", "budget"],
        "properties": {
          "childBriefId": { "type": "string", "minLength": 1 },
          "childBriefDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "idempotencyKey": { "type": "string", "minLength": 1 },
          "allowPaths": { "type": "array", "items": { "type": "string" } },
          "budget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maxTokens", "maxWallClockMin"],
            "properties": {
              "maxTokens": { "type": "integer" },
              "maxWallClockMin": { "type": "integer" }
            }
          }
        }
      }
    },
    "leaseInheritance": { "const": true },
    "budgetConservationDeclared": { "type": "integer" },
    "state": { "enum": ["proposed", "accepted", "refused"] },
    "createdAt": { "type": "string", "minLength": 1 }
  }
}
