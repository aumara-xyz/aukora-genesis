{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.aukora.xyz/swarm/CampaignManifestV1.json",
  "title": "CampaignManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "campaignId", "issueNumbers", "baseCommit", "baseTreeDigest", "budget", "state", "createdAt"],
  "properties": {
    "schema": { "const": "aukora-swarm-campaign-manifest-v1" },
    "campaignId": { "type": "string", "minLength": 1 },
    "issueNumbers": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "baseTreeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxWorkers", "maxProposals", "maxWallClockMin", "haltOnVerifyRed"],
      "properties": {
        "maxWorkers": { "type": "integer" },
        "maxProposals": { "type": "integer" },
        "maxWallClockMin": { "type": "integer" },
        "maxTokens": { "type": "integer" },
        "haltOnVerifyRed": { "type": "boolean" }
      }
    },
    "state": { "enum": ["draft", "running", "conserve", "halt_new_work", "complete", "cancelled"] },
    "createdAt": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  }
}
