{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.aukora.xyz/swarm/EngineTenantV1.json",
  "title": "EngineTenantV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "engineId",
    "adapterVersion",
    "modelProvider",
    "briefDigest",
    "leaseDigest",
    "baseCommit",
    "baseTreeDigest",
    "timeoutMs",
    "networkPolicy",
    "environmentAllowlist"
  ],
  "properties": {
    "schema": { "const": "aukora-swarm-engine-tenant-v1" },
    "engineId": { "type": "string", "minLength": 1 },
    "adapterVersion": { "type": "string", "minLength": 1 },
    "modelProvider": { "type": "string", "minLength": 1 },
    "briefDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "leaseDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "baseTreeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timeoutMs": { "type": "integer", "minimum": 1 },
    "networkPolicy": { "enum": ["deny", "local-only", "allow-egress"] },
    "environmentAllowlist": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
