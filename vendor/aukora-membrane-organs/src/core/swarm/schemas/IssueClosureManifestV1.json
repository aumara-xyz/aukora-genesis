{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.aukora.xyz/swarm/IssueClosureManifestV1.json",
  "title": "IssueClosureManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "issueNumber", "campaignId", "briefId", "baseCommit", "baseTreeDigest", "landedCommit", "outsideVerifierId", "outsideVerifierDigest", "workerDidClose", "state", "closedAt"],
  "properties": {
    "schema": { "const": "aukora-swarm-issue-closure-manifest-v1" },
    "issueNumber": { "type": "integer" },
    "campaignId": { "type": "string", "minLength": 1 },
    "briefId": { "type": "string", "minLength": 1 },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "baseTreeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "landedCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "outsideVerifierId": { "type": "string", "minLength": 1 },
    "outsideVerifierDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "workerDidClose": { "const": false },
    "state": { "enum": ["closed", "rejected"] },
    "closedAt": { "type": "string", "minLength": 1 }
  }
}
