{
  "schema": "aukora:launch-topology:v1",
  "platform": "darwin",
  "humanSession": {
    "source": "invoking-process-user",
    "approvalJobLabel": "xyz.aumara.aukora.approval"
  },
  "services": {
    "issuer": {
      "account": "_aukora_issuer",
      "jobLabel": "xyz.aumara.aukora.issuer"
    },
    "broker": {
      "account": "_aukora_broker",
      "jobLabel": "xyz.aumara.aukora.broker"
    },
    "guest": {
      "account": "_aukora_guest",
      "jobLabel": "xyz.aumara.aukora.guest"
    }
  },
  "routes": {
    "humanIssuer": {
      "group": "_aukora_human_issuer",
      "directoryPath": "/private/var/run/aukora/human-issuer",
      "socketPath": "/private/var/run/aukora/human-issuer/approval.sock"
    },
    "brokerIssuer": {
      "group": "_aukora_broker_issuer",
      "directoryPath": "/private/var/run/aukora/broker-issuer",
      "socketPath": "/private/var/run/aukora/broker-issuer/grant.sock"
    },
    "guestBroker": {
      "group": "_aukora_guest_broker",
      "directoryPath": "/private/var/run/aukora/guest-broker",
      "socketPath": "/private/var/run/aukora/guest-broker/effect.sock"
    }
  },
  "protectedPaths": [
    {
      "kind": "socket-root",
      "path": "/private/var/run/aukora"
    },
    {
      "kind": "root-key",
      "path": "/private/var/db/aukora/issuer/keys/root.json"
    },
    {
      "kind": "receipt-key",
      "path": "/private/var/db/aukora/broker/keys/broker.json"
    },
    {
      "kind": "nonce-state",
      "path": "/private/var/db/aukora/broker/nonces"
    },
    {
      "kind": "evidence",
      "path": "/private/var/db/aukora/broker/aura.jsonl"
    },
    {
      "kind": "active-profile",
      "path": "/private/var/db/aukora/active/profile"
    },
    {
      "kind": "active-artifact",
      "path": "/private/var/db/aukora/active/artifact"
    },
    {
      "kind": "implementation-closure",
      "path": "/private/var/db/aukora/active/implementation"
    },
    {
      "kind": "guest-scratch",
      "path": "/private/var/db/aukora/guest/scratch"
    }
  ]
}
