<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- AUKORA broker LaunchDaemon template. Generate and lint before installation. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@@BROKER_LABEL@@</string>

  <key>UserName</key>
  <string>@@BROKER_USER@@</string>

  <key>GroupName</key>
  <string>@@BROKER_GROUP@@</string>

  <key>ProgramArguments</key>
  <array>
    <string>@@NODE_BIN@@</string>
    <string>@@IMPLEMENTATION_ROOT@@/scripts/launchd-broker-entry.mjs</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_OPTIONS</key>
    <string></string>
    <key>NODE_PATH</key>
    <string></string>
    <key>NODE_REPL_EXTERNAL_MODULE</key>
    <string></string>
    <key>ELECTRON_RUN_AS_NODE</key>
    <string></string>
    <key>NODE_COMPILE_CACHE</key>
    <string></string>
    <key>LD_PRELOAD</key>
    <string></string>
    <key>LD_AUDIT</key>
    <string></string>
    <key>LD_LIBRARY_PATH</key>
    <string></string>
    <key>DYLD_INSERT_LIBRARIES</key>
    <string></string>
    <key>DYLD_FRAMEWORK_PATH</key>
    <string></string>
    <key>DYLD_LIBRARY_PATH</key>
    <string></string>
    <key>DYLD_FALLBACK_LIBRARY_PATH</key>
    <string></string>
    <key>OPENSSL_CONF</key>
    <string></string>
    <key>OPENSSL_MODULES</key>
    <string></string>
    <key>AUKORA_SOCKET</key>
    <string>@@BROKER_SOCKET@@</string>
    <key>AUKORA_SOCKET_GROUP_ACCESS</key>
    <string>1</string>
    <key>AUKORA_ISSUER_SOCKET</key>
    <string>@@ISSUER_SOCKET@@</string>
    <key>AUKORA_STATE_DIR</key>
    <string>@@BROKER_STATE_DIR@@</string>
    <key>AUKORA_ROOT_PEM</key>
    <string>@@ROOT_PUBLIC_KEY_PEM@@</string>
    <key>AUKORA_REVIEW_SOCKET</key>
    <string>@@REVIEW_SOCKET@@</string>
    <key>AUKORA_REVIEW_TERMINAL_PUBLIC_KEY_FILE</key>
    <string>@@REVIEW_TERMINAL_PUBLIC_KEY_FILE@@</string>
    <key>AUKORA_REVIEW_SERVER_ID</key>
    <string>@@REVIEW_SERVER_ID@@</string>
    <key>AUKORA_ACTIVATION_DIGEST</key>
    <string>@@ACTIVATION_DIGEST@@</string>
    <key>AUKORA_RENDERER_ID</key>
    <string>@@RENDERER_ID@@</string>
@@MEMORY_ENVIRONMENT@@  </dict>

  <key>WorkingDirectory</key>
  <string>@@BROKER_STATE_DIR@@</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>Umask</key>
  <integer>63</integer>

  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
